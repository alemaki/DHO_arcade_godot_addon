## Built once on first use and used as a set.
static var _lookup: Dictionary = {}

static func contains(word: String) -> bool:
	if _lookup.is_empty():
		for w in WORDS:
			_lookup[w.to_lower()] = true
	return _lookup.has(word.to_lower())
